# ── LLM Provider ─────────────────────────────────────
# Options: "gemini", "ollama", or "auto"
LLM_PROVIDER=auto

# Google Gemini API Key (FREE from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama local model (if using local fallback)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# ── Telegram Bot (Optional for remote triggers) ──────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Schedule & Output Settings ───────────────────────
DAILY_POST_TIME=09:00
OUTPUT_DIR=output
